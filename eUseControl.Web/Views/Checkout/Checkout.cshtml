@{
    Layout = "~/Views/Shared/_LayoutCheckout.cshtml";
    ViewBag.Title = "Checkout";
}

@model eUseControl.Web.Models.Order.OrderViewModel

<div class="container py-5">
    <h1 class="mb-4">Billing details</h1>
    @using (Html.BeginForm("PlaceOrder", "Checkout", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CouponCode)
        <div class="row g-5">
            <div class="col-md-12 col-lg-6 col-xl-7">
                <div class="row">
                    <div class="col-md-12 col-lg-6">
                        <div class="form-item w-100">
                            @Html.Raw($"<label for='{Html.IdFor(m => m.Order.FirstName)}' class='form-label my-3'>First Name<sup>*</sup></label>")
                            @Html.TextBoxFor(m => m.Order.FirstName, new { @class = "form-control", required = "required" })
                        </div>
                    </div>
                    <div class="col-md-12 col-lg-6">
                        <div class="form-item w-100">
                            @Html.Raw($"<label for='{Html.IdFor(m => m.Order.LastName)}' class='form-label my-3'>Last Name<sup>*</sup></label>")
                            @Html.TextBoxFor(m => m.Order.LastName, new { @class = "form-control", required = "required" })
                        </div>
                    </div>
                </div>
                <div class="form-item">
                    @Html.Raw($"<label for='{Html.IdFor(m => m.Order.DeliveryAddress)}' class='form-label my-3'>Delivery Address<sup>*</sup></label>")
                    @Html.TextBoxFor(m => m.Order.DeliveryAddress, new { @class = "form-control", required = "required" })
                </div>
                <div class="form-item">
                    @Html.Raw($"<label for='{Html.IdFor(m => m.Order.PhoneNumber)}' class='form-label my-3'>Mobile<sup>*</sup></label>")
                    @Html.TextBoxFor(m => m.Order.PhoneNumber, new { @class = "form-control", type = "tel", required = "required" })
                </div>
                <div class="form-item">
                    @Html.Raw($"<label for='{Html.IdFor(m => m.Order.Email)}' class='form-label my-3'>Email<sup>*</sup></label>")
                    @Html.TextBoxFor(m => m.Order.Email, new { @class = "form-control", type = "email", required = "required" })
                </div>
                <div class="form-item" style="margin-top: 3.5rem;">
                    @Html.TextAreaFor(m => m.Order.Notes, 11, 30, new { @class = "form-control", placeholder = "Order Notes (optional)", spellcheck = "false" })
                </div>
            </div>
            <div class="col-md-12 col-lg-6 col-xl-5">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Products</th>
                                <th scope="col">Name</th>
                                <th scope="col">Price</th>
                                <th scope="col">Quantity</th>
                                <th scope="col">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <th scope="row">
                                        <div class="d-flex align-items-center">
                                            <a href="@Url.Action("ProductDetails", "Product", new { productId = item.ProductId })">
                                                <img src="@Url.Content(item.ProductImageUrl)" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" alt="">
                                            </a>
                                        </div>
                                    </th>
                                    <td class="py-5" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px; display: inline-block; vertical-align: middle;">@Html.DisplayFor(modelItem => item.ProductName)</td>
                                    <td class="py-5">$@Html.DisplayFor(modelItem => item.ProductPrice)</td>
                                    <td class="py-5">@Html.DisplayFor(modelItem => item.SelectedQuantity)</td>
                                    <td class="py-5">$@Html.DisplayFor(modelItem => item.Subtotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row g-4 text-center align-items-center justify-content-center border-bottom py-3">
                    <div class="form-check" style="margin-left: 40px;">
                        @Html.RadioButtonFor(m => m.Order.PaymentMethod, "Cash", new { @class = "form-check-input", id = "option1" })
                        @Html.Label("option1", "Cash on Delivery", new { @class = "form-check-label" })
                    </div>
                    <div class="form-check" style="margin-left: 40px;">
                        @Html.RadioButtonFor(m => m.Order.PaymentMethod, "Card", new { @class = "form-check-input", id = "option2" })
                        @Html.Label("option2", "Card Payment", new { @class = "form-check-label" })
                    </div>
                </div>
            </div>
        </div>
        <div class="container mt-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start">
                <div class="col-12 col-md-6 col-lg-5 col-xl-4 mt-4 mt-md-0 ms-auto" style="margin-right: 30px;">
                    <div class="bg-light rounded">
                        <div class="p-4">
                            <h1 class="h4 mb-3 fw-bold text-center border-bottom pb-2">Your Total</h1>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="fw-semibold">Subtotal:</span>
                                <span>$@Html.DisplayFor(m => m.InitialPrice)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="fw-semibold">Discount rate:</span>
                                <span class="text-muted">$@Html.DisplayFor(m => m.DiscountRate)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="fw-semibold">Delivery cost:</span>
                                <span>$@Html.DisplayFor(m => m.DeliveryPrice)</span>
                            </div>
                        </div>
                        <div class="py-4 mb-4 border-top border-bottom d-flex justify-content-between px-4" style="font-size: 16px;">
                            <h5 class="mb-0">Total</h5>
                            <p class="mb-0">$@Html.DisplayFor(m => m.TotalPrice)</p>
                        </div>
                        <div class="row pt-2 mt-4">
                            <div class="col-auto ms-3">
                                <button type="submit" class="btn border border-secondary rounded-pill px-4" style="position: relative; top: -13px; padding-top: 15px; padding-bottom: 15px; color: #81c408;">
                                    Place Order
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="mt-4 mt-md-0" style="position: relative; top: -350px;">
        @using (Html.BeginForm("Checkout", "Checkout", FormMethod.Get))
        {
            <div class="d-flex align-items-center">
                @Html.TextBox("couponCode", null, new { @class = "border-0 border-bottom rounded me-3 py-3 ps-4 login-wrapper", placeholder = "Coupon Code" })
                <button class="btn border-secondary rounded-pill px-4 py-3 text-primary" type="submit">
                    Apply Coupon
                </button>
            </div>
        }
    </div>
</div>