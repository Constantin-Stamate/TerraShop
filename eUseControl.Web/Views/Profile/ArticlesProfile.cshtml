﻿@{
    Layout = "~/Views/Shared/_LayoutArticlesProfile.cshtml";
    ViewBag.Title = "ArticlesProfile";
}

@model IEnumerable<eUseControl.Web.Models.Product.ProductCompact>

<div class="card profile-card overflow-hidden">
    <div class="row no-gutters">
        <div class="col-md-3">
            <div class="list-group list-group-flush account-settings-links">
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("GeneralProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">General</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("ChangePasswordProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Change password</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("SettingsProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Profile settings</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("ArticlesProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Articles</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("OrdersProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Orders</a>
            </div>
        </div>
        <div class="col-md-9 py-5">
            <h4 style="color: #81c408;">My Articles</h4>
            @if (Model == null || !Model.Any())
            {
                <div class="no-products-message" style="color: #888; font-size: 1em; margin-bottom: 50px; margin-top: 23px;">
                    Let’s get started! Add your first product now!
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center py-5">
                    @foreach (var product in Model)
                    {
                        <div class="col" style="margin-top: 2px; margin-bottom: 20px;">
                            <div class="card h-100 rounded position-relative shadow-sm border-0 anim">
                                <div class="fruite2-img position-relative">
                                    <a href="@Url.Action("ProductDetails", "Product", new { productId = product.Id })">
                                        <img src="@Url.Content(product.ProductImageUrl)" class="img-fluid w-100 rounded-top card-img-top" alt="Product Image" style="object-fit: cover; height: 200px;">
                                    </a>
                                    <div class="position-absolute top-0 end-0 m-2">
                                        @using (Html.BeginForm("ChangeProductStatus", "Product", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("productId", product.Id)
                                            <button type="submit" class="btn btn-sm px-3 pulse-js" style="background-color: #FFB524; color: white;">
                                                @(product.ProductStatus == eUseControl.Domain.Enums.ProductStatus.Available ? "Deactivate" : "Activate")
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="card-body p-4 border border-top-0 rounded-bottom" style="border-color: #f6ba31; min-height: 200px;">
                                    <h5 class="card-title text-center product-name">@Html.DisplayFor(m => product.ProductName)</h5>
                                    <p class="card-text text-muted small product-description text-center">@Html.DisplayFor(m => product.ProductDescription)</p>
                                    <p class="text-dark fs-5 fw-bold mb-0">
                                        <span>$@Html.DisplayFor(m => product.ProductPrice)</span>
                                    </p>
                                    <div class="d-flex justify-content-between flex-lg-wrap mt-3">
                                        <a href="@Url.Action("UpdateProduct", "Product", new { Id = product.Id })" class="btn rounded-pill px-3 pulse-js" style="transition: all 0.3s ease; border: 1px solid #FFB524; text-decoration: none; color: #81C408;" onmouseover="this.style.color='white'" onmouseout="this.style.color='#81C408'">
                                            Change
                                        </a>
                                        @using (Html.BeginForm("DeleteProduct", "Product", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("productId", product.Id)
                                            <button type="submit" class="btn rounded-pill px-3 pulse-js" style="color: #B22222; transition: all 0.3s ease; border: 1px solid #FFB524; white-space: nowrap; text-decoration: none;" onclick="return confirm('Are you sure you want to delete this product?');" onmouseover="this.style.backgroundColor='#FFB524'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#dc3545';">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>