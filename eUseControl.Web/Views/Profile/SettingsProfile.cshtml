﻿@{
    Layout = "~/Views/Shared/_LayoutSettingsProfile.cshtml";
    ViewBag.Title = "SettingsProfile";
}

@model eUseControl.Web.Models.Profile.ProfileCompact

<div class="card profile-card overflow-hidden">
    <div class="row no-gutters">
        <div class="col-md-3">
            <div class="list-group list-group-flush account-settings-links">
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("GeneralProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">General</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("ChangePasswordProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Change password</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("SettingsProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Profile settings</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("ArticlesProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Articles</a>
                <a class="list-group-item list-group-item-action btn border border-secondary rounded-pill px-3 text-primary" href="@Url.Action("OrdersProfile", "Profile")" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Orders</a>
            </div>
        </div>
        <div class="col-md-9">
            @using (Html.BeginForm("SettingsProfile", "Profile", FormMethod.Post, new { @id = "UpdateProfile", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UserId)
                <div class="tab-content">
                    <div class="tab-pane fade active show" id="account-general">
                        <div class="card-body d-flex align-items-center flex-column text-center">
                            @Html.Label("profileImage", "Upload new photo", new { @class = "btn-recycle btn border border-secondary align-items-center me-3 pulse-js" })
                            @Html.TextBox("profileImage", null, new { type = "file", id = "profileImage", accept = "image/*", @class = "account-settings-fileinput d-none" })
                            <div id="uploadSuccessMessage" class="text-success mt-3 d-none"></div>
                            <small class="text-muted mt-3">Allowed: JPG, GIF, PNG. Max size: 800KB</small>
                        </div>
                        <div style="margin-top: 10px;">
                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="text-danger no-bullets" style="text-align: center; margin-top: -10px">
                                    <ul>
                                        <li>@TempData["ErrorMessage"]</li>
                                    </ul>
                                </div>
                            }
                            <div class="border-bottom border-light my-3"></div>
                            <div class="card-body">
                                <div class="form-group">
                                    @Html.Raw("<span class='form-label mb-1'><i class='fas fa-user mr-2'></i> First Name</span>")
                                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control mb-3", placeholder = "Enter your first name", required = "required", style = "font-size: 0.9em; margin-top: 8px;" })
                                </div>
                                <div class="form-group">
                                    @Html.Raw("<span class='form-label'><i class='fas fa-user-tag mr-2'></i> Last Name</span>")
                                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control mb-3", placeholder = "Enter your last name", required = "required", style = "font-size: 0.9em; margin-top: 8px;" })
                                </div>
                                <div class="form-group">
                                    @Html.Raw("<span class='form-label'><i class='fas fa-envelope mr-2'></i> E-mail</span>")
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control mb-3", placeholder = "Enter your email", required = "required", style = "font-size: 0.9em; margin-top: 8px;" })
                                </div>
                                <div class="form-group">
                                    @Html.Raw("<span class='form-label'><i class='fas fa-map-marker-alt mr-2'></i> Address</span>")
                                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control mb-3", placeholder = "Enter your address", required = "required", style = "font-size: 0.9em; margin-top: 8px;" })
                                </div>
                                <div class="form-group">
                                    @Html.Raw("<span class='form-label'><i class='fas fa-phone mr-2'></i> Phone number</span>")
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control mb-3", placeholder = "Enter your phone number", required = "required", style = "font-size: 0.9em; margin-top: 8px;" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <button type="submit" class="btn-recycle btn border border-secondary align-items-center me-3 pulse-js">
                            <i class="fas fa-cloud-download-alt" style="margin-right:6px;"></i>Save changes
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>