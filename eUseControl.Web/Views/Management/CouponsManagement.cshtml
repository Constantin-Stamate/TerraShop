@{
    Layout = "~/Views/Shared/_LayoutCouponsManagement.cshtml";
    ViewBag.Title = "CouponsManagement";
}

@model IEnumerable<eUseControl.Web.Models.Cart.CouponCompact>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">There are currently no discount coupons available in the system!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Discount Percent</th>
                        <th scope="col">Expiration Date</th>
                        <th scope="col">Is Active</th>
                        <th scope="col">Handle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model)
                    {
                        <tr>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(m => coupon.Code)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.DisplayFor(m => coupon.DiscountPercent)%</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.Raw(coupon.ExpirationDate.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture))</p>
                            </td>
                            <td>
                                @if (coupon.IsActive)
                                {
                                    <div class="mt-4 px-2 py-1 text-success border border-success rounded" style="display: inline-block; background-color: #d4edda;">
                                        True
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-4 px-2 py-1 text-danger border border-danger rounded" style="display: inline-block; background-color: #f8d7da;">
                                        False
                                    </div>
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("DeleteDiscountCoupon", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("couponId", coupon.Id)
                                    <button type="submit" class="btn btn-md rounded-circle bg-light border mt-4 pulse-js" onclick="return confirm('Are you sure you want to delete this discount coupon?');">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>