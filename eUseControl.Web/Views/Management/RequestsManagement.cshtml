@{
    Layout = "~/Views/Shared/_LayoutRequestsManagement.cshtml";
    ViewBag.Title = "RequestsManagement";
}

@model IEnumerable<eUseControl.Web.Models.Contact.ContactInfo>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">There are currently no contact requests in the system!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Message</th>
                        <th scope="col">Request Date</th>
                        <th scope="col">Request Status</th>
                        <th scope="col">Handle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => request.Username)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => request.Email)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => request.Message)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.Raw(request.RequestPostDate.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture))</p>
                            </td>
                            <td>
                                @using (Html.BeginForm("ChangeRequestStatus", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("requestId", request.Id)
                                    if (request.RequestStatus == eUseControl.Domain.Enums.RequestStatus.Pending)
                                    {
                                        <button type="submit" class="mt-4 px-2 py-1 text-warning border border-warning rounded" style="background-color: #fff3cd; border: 1px solid #ffc107;">
                                            @Html.DisplayFor(model => request.RequestStatus)
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="mt-4 px-2 py-1 rounded" style="background-color: #d1ecf1; color: #0c5460; border: 1px solid #0c5460;">
                                            @Html.DisplayFor(model => request.RequestStatus)
                                        </button>
                                    }
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("DeleteRequest", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("requestId", request.Id)
                                    <button type="submit" class="btn btn-md rounded-circle bg-light border mt-4" onclick="return confirm('Are you sure you want to delete this contact request?');">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>