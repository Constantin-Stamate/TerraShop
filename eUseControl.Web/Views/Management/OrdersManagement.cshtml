@{
    Layout = "~/Views/Shared/_LayoutOrdersManagement.cshtml";
    ViewBag.Title = "OrdersManagement";
}

@model IEnumerable<eUseControl.Web.Models.Order.OrderInfo>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">There are currently no orders in the system!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Image</th>
                        <th scope="col">Total</th>
                        <th scope="col">Payment Method</th>
                        <th scope="col">Order Date</th>
                        <th scope="col">Order Status</th>
                        <th scope="col">Delivery Address</th>
                        <th scope="col">Phone Number</th>
                        <th scope="col">Handle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <th scope="row">
                                <div class="d-flex align-items-center">
                                    <img src="@Url.Content(order.OrderImageUrl)" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" alt="">
                                </div>
                            </th>
                            <td>
                                <p class="mb-0 mt-4">$@Html.DisplayFor(m => order.TotalPrice)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.DisplayFor(m => order.PaymentMethod)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.Raw(order.OrderDate.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture))</p>
                            </td>
                            <td>
                                @using (Html.BeginForm("ChangeOrderStatus", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("orderId", order.Id)
                                    if (order.OrderStatus == eUseControl.Domain.Enums.OrderStatus.Pending)
                                    {
                                        <button type="submit" class="mt-4 px-2 py-1 text-warning border border-warning rounded" style="background-color: #fff3cd; border: 1px solid #ffc107;">
                                            @Html.DisplayFor(m => order.OrderStatus)
                                        </button>
                                    }
                                    else if (order.OrderStatus == eUseControl.Domain.Enums.OrderStatus.Delivering)
                                    {
                                        <button type="submit" class="mt-4 px-2 py-1 rounded" style="background-color: #d1ecf1; color: #0c5460; border: 1px solid #0c5460;">
                                            @Html.DisplayFor(m => order.OrderStatus)
                                        </button>
                                    }
                                    else if (order.OrderStatus == eUseControl.Domain.Enums.OrderStatus.Cancelled)
                                    {
                                        <span class="mt-4 px-2 py-1 text-danger border border-danger rounded" style="display: inline-block; background-color: #f8d7da;">
                                            @Html.DisplayFor(m => order.OrderStatus)
                                        </span>
                                    }
                                }
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(m => order.DeliveryAddress)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(m => order.PhoneNumber)</p>
                            </td>
                            <td>
                                @using (Html.BeginForm("DeleteOrder", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("orderId", order.Id)
                                    <button type="submit" class="btn btn-md rounded-circle bg-light border mt-4 pulse-js" onclick="return confirm('Are you sure you want to delete this order?');">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>