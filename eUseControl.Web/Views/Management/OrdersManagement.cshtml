@{
    Layout = "~/Views/Shared/_LayoutOrdersManagement.cshtml";
    ViewBag.Title = "OrdersManagement";
}

<div class="container py-5">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Total</th>
                    <th scope="col">Payment Method</th>
                    <th scope="col">Order Date</th>
                    <th scope="col">Order Status</th>
                    <th scope="col">Delivery Address</th>
                    <th scope="col">Phone Number</th>
                    <th scope="col">Handle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">
                        <div class="d-flex align-items-center">
                            <img src="volunteer-product-1.jpg" class="img-fluid me-5 rounded-circle"
                                 style="width: 80px; height: 80px;" alt="">
                        </div>
                    </th>
                    <td>
                        <p class="mb-0 mt-4">$18.45</p>
                    </td>
                    <td>
                        <p class="mb-0 mt-4">Cash</p>
                    </td>
                    <td>
                        <p class="mb-0 mt-4">21.11.12 12:23:45</p>
                    </td>
                    <td>
                        <div class="mt-4 px-2 py-1 text-success border border-success rounded"
                             style="display: inline-block; background-color: #d4edda;">
                            Pending
                        </div>
                    </td>
                    <td>
                        <p class="title-truncate mb-0 mt-4">Bucharest Street, Chișinău</p>
                    </td>
                    <td>
                        <p class="mb-0 mt-4">067896451</p>
                    </td>
                    <td>
                        <button class="btn btn-md rounded-circle bg-light border mt-4">
                            <i class="fa fa-times text-danger"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>