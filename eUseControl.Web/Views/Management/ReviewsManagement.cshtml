@{
    Layout = "~/Views/Shared/_LayoutReviewsManagement.cshtml";
    ViewBag.Title = "ReviewsManagement";
}

<div class="container py-5">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Avatar</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Review</th>
                    <th scope="col">Rating</th>
                    <th scope="col">Post Date</th>
                    <th scope="col">Handle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">
                        <div class="d-flex align-items-center">
                            <img src="volunteer-product-1.jpg" class="img-fluid me-5 rounded-circle"
                                 style="width: 80px; height: 80px;" alt="">
                        </div>
                    </th>
                    <td>
                        <p class="mb-0 mt-4 truncate-text">Stamate Constantin</p>
                    </td>
                    <td>
                        <p class="mb-0 mt-4 truncate-text">I was really impressed by how easy it is to navigate TerraShop. The interface is intuitive, and the personalized recommendations helped me discover sustainable products I wouldn’t have found otherwise. I bought an eco-friendly bathroom set, and the delivery was fast with recyclable packaging – exactly what I was looking for! Highly recommend!</p>
                    </td>
                    <td>
                        <p class="mb-0 mt-4">5</p>
                    </td>
                    <td>
                        <p class="mb-0 mt-4">08.06.2025 17:14:57</p>
                    </td>
                    <td>
                        <button class="btn btn-md rounded-circle bg-light border mt-4">
                            <i class="fa fa-times text-danger"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>