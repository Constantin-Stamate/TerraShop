@{
    Layout = "~/Views/Shared/_LayoutReviewsManagement.cshtml";
    ViewBag.Title = "ReviewsManagement";
}

@model IEnumerable<eUseControl.Web.Models.Review.ReviewInfo>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">There are currently no reviews available in the system!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Avatar</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Review</th>
                        <th scope="col">Rating</th>
                        <th scope="col">Post Date</th>
                        <th scope="col">Handle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <th scope="row">
                                <div class="d-flex align-items-center">
                                    <img src="@Url.Content(review.ProfileImageUrl)" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" alt="">
                                </div>
                            </th>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => review.FirstName) @Html.DisplayFor(model => review.LastName)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => review.Review)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.DisplayFor(model => review.Rating)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.Raw(review.ReviewPostDate.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture))</p>
                            </td>
                            <td>
                                @using (Html.BeginForm("DeleteReview", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("reviewId", review.Id)
                                    <button type="submit" class="btn btn-md rounded-circle bg-light border mt-4 pulse-js" onclick="return confirm('Are you sure you want to delete this review?');">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>