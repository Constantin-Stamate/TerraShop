@{
    Layout = "~/Views/Shared/_LayoutProductsManagement.cshtml";
    ViewBag.Title = "ProductsManagement";
}

@model IEnumerable<eUseControl.Web.Models.Product.ProductInfo>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">There are currently no products available in the system!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Image</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Category</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Recommendation Status</th>
                        <th scope="col">Handle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <th scope="row">
                                <a href="@Url.Action("ProductDetails", "Product", new { productId = product.Id })">
                                    <img src="@Url.Content(product.ProductImageUrl)" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" alt="">
                                </a>
                            </th>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(m => product.ProductName)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">$@Html.DisplayFor(m => product.ProductPrice)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(m => product.ProductCategory)</p>
                            </td>
                            <td>
                                @if (product.ProductQuantity > 0)
                                {
                                    <div class="mt-4 px-2 py-1 text-success border border-success rounded" style="display: inline-block; background-color: #d4edda;">
                                        In Stock
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-4 px-2 py-1 text-danger border border-danger rounded" style="display: inline-block; background-color: #f8d7da;">
                                        Out of Stock
                                    </div>
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("ChangeRecommendationStatus", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("productId", product.Id)
                                    if (product.RecommendationStatus == eUseControl.Domain.Enums.RecommendationStatus.Preferred)
                                    {
                                        <button type="submit" class="mt-4 px-2 py-1 text-success border border-success rounded" style="background-color: #d4edda; border: none;">
                                            @product.RecommendationStatus
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="mt-4 px-2 py-1 text-danger border border-danger rounded" style="background-color: #f8d7da; border: none;">
                                            @product.RecommendationStatus
                                        </button>
                                    }
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("DeleteProduct", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("productId", product.Id)
                                    <button type="submit" class="btn btn-md rounded-circle bg-light border mt-4 pulse-js" onclick="return confirm('Are you sure you want to delete this product?');">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>