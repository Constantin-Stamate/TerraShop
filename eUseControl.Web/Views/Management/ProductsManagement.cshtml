@{
    Layout = "~/Views/Shared/_LayoutProductsManagement.cshtml";
    ViewBag.Title = "ProductsManagement";
}

<div class="container py-5">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Name</th>
                    <th scope="col">Price</th>
                    <th scope="col">Category</th>
                    <th scope="col">Stock</th>
                    <th scope="col">Recommendation Status</th>
                    <th scope="col">Handle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">
                        <div class="d-flex align-items-center">
                            <img src="volunteer-product-1.jpg" class="img-fluid me-5 rounded-circle"
                                 style="width: 80px; height: 80px;" alt="">
                        </div>
                    </th>
                    <td>
                        <p class="title-truncate mb-0 mt-4">Nourishing Face Cream</p>
                    </td>
                    <td>
                        <p class="mb-0 mt-4">$18.45</p>
                    </td>
                    <td>
                        <p class="title-truncate mb-0 mt-4">Personal Care</p>
                    </td>
                    <td>
                        <div class="mt-4 px-2 py-1 text-success border border-success rounded"
                             style="display: inline-block; background-color: #d4edda;">
                            In Stock
                        </div>
                    </td>
                    <td>
                        <div class="mt-4 px-2 py-1 text-success border border-success rounded"
                             style="display: inline-block; background-color: #d4edda;">
                            Preferred
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-md rounded-circle bg-light border mt-4">
                            <i class="fa fa-times text-danger"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>