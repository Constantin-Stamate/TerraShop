﻿@{
    Layout = "~/Views/Shared/_LayoutUsersManagement.cshtml";
    ViewBag.Title = "UsersManagement";
}

@model IEnumerable<eUseControl.Web.Models.User.UserInfo>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">There are currently no users in the system!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Avatar</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Email</th>
                        <th scope="col">Address</th>
                        <th scope="col">Phone Number</th>
                        <th scope="col">Orders</th>
                        <th scope="col">Total Spent</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <th scope="row">
                                <div class="d-flex align-items-center">
                                    <img src="@Url.Content(user.ProfileImageUrl)" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" alt="">
                                </div>
                            </th>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => user.Username)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => user.Email)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => user.Address)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(model => user.PhoneNumber)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.DisplayFor(model => user.OrderCount)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">$@Html.DisplayFor(model => user.TotalSpent)</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>