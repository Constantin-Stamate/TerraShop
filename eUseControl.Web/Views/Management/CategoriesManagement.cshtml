@{
    Layout = "~/Views/Shared/_LayoutCategoriesManagement.cshtml";
    ViewBag.Title = "CategoriesManagement";
}

@model IEnumerable<eUseControl.Web.Models.Product.ProductCategory>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">There are currently no categories available!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Category Name</th>
                        <th scope="col">Category Number</th>
                        <th scope="col">Handle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>
                                <p class="mb-0 mt-4 truncate-text">@Html.DisplayFor(m => category.CategoryName)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.DisplayFor(m => category.Id)</p>
                            </td>
                            <td>
                                @using (Html.BeginForm("DeleteCategory", "Management", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("categoryId", category.Id)
                                    <button type="submit" class="btn btn-md rounded-circle bg-light border mt-4" onclick="return confirm('Are you sure you want to delete this category?');">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @using (Html.BeginForm("AddCategory", "Management", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="mt-5">
            @Html.TextBox("categoryName", null, new { @class = "border-0 border-bottom rounded me-5 py-3 mb-4 ps-4", placeholder = "Category Name", required = "required" })
            <button class="btn border-secondary rounded-pill px-4 py-3 text-primary" type="submit">
                Create Category
            </button>
        </div>
    }
</div>