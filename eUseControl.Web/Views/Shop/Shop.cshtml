@{
    Layout = "~/Views/Shared/_LayoutShop.cshtml";
    ViewBag.Title = "Shop";
}

@model eUseControl.Web.Models.Product.ProductCatalogViewModel

<div class="container py-5">
    <h1 class="mb-4">TerraBio Market</h1>
    <div class="row g-4">
        <div class="col-lg-12">
            <div class="row g-4">
                <div class="col-xl-3">
                    @using (Html.BeginForm("Shop", "Shop", FormMethod.Get, new { @class = "input-group w-100 mx-auto d-flex" }))
                    {
                        if (Model.CategoryId != null && Model.CategoryId != 0)
                        {
                            @Html.Hidden("categoryId", Model.CategoryId)
                        }
                        if (!string.IsNullOrEmpty(Model.SortOption))
                        {
                            @Html.Hidden("sortOption", Model.SortOption)
                        }
                        if (Model.MaxPrice > 0)
                        {
                            @Html.Hidden("maxPrice", Model.MaxPrice)
                        }
                        if (!string.IsNullOrEmpty(Model.Country))
                        {
                            @Html.Hidden("country", Model.Country)
                        }
                        @Html.TextBox("searchQuery", null, new { @class = "form-control p-3 border border-secondary", placeholder = "Search", aria_describedby = "search-icon-1", style = "border-top-left-radius: 0.375rem; border-bottom-left-radius: 0.375rem;" })
                        <button type="submit" class="btn btn-primary p-3" style="background-color: #FFB524; border-color: #FFB524 !important; border: 2px solid #FFB524;">
                            <i class="fa fa-search"></i>
                        </button>
                    }
                </div>
                <div class="col-6"></div>
                <div class="col-xl-3">
                    <div class="bg-light ps-3 py-3 rounded d-flex align-items-center mb-4" style="gap: 10px; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);">
                        <label for="fruits" class="mb-0" style="font-size: 14px; margin-right: 50px;">
                            Default Sorting:
                        </label>
                        @using (Html.BeginForm("Shop", "Shop", FormMethod.Get))
                        {
                            if (Model.CategoryId != null && Model.CategoryId != 0)
                            {
                                @Html.Hidden("categoryId", Model.CategoryId)
                            }
                            if (Model.MaxPrice > 0)
                            {
                                @Html.Hidden("maxPrice", Model.MaxPrice)
                            }
                            if (!string.IsNullOrEmpty(Model.SearchQuery))
                            {
                                @Html.Hidden("searchQuery", Model.SearchQuery)
                            }
                            if (!string.IsNullOrEmpty(Model.Country))
                            {
                                @Html.Hidden("country", Model.Country)
                            }
                            @Html.DropDownList("sortOption",
                                new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Option", Value = "", Disabled = true, Selected = string.IsNullOrEmpty(Model.SortOption) },
                                    new SelectListItem { Text = "Price ↑", Value = "lowToHigh", Selected = Model.SortOption == "lowToHigh" },
                                    new SelectListItem { Text = "Price ↓", Value = "highToLow", Selected = Model.SortOption == "highToLow" },
                                    new SelectListItem { Text = "Old →", Value = "oldest", Selected = Model.SortOption == "oldest" },
                                    new SelectListItem { Text = "New →", Value = "newest", Selected = Model.SortOption == "newest" }
                                },
                                new { @class = "border-0 form-select-sm bg-light", style = "padding: 3px 5px; width: 110px;", onchange = "this.form.submit()" }
                            )
                        }
                    </div>
                </div>
            </div>
            <div class="row g-4">
                <div class="col-lg-3">
                    <div class="row g-4">
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <h4>Categories</h4>
                                <ul class="list-unstyled fruite-categorie" style="margin-left: 7px;">
                                    <li>
                                        <div class="d-flex fruite-name">
