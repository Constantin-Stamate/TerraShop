                                                </a>
                                                <span class="ms-auto" style="margin-right: 25px;">(@category.Value)</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        @using (Html.BeginForm("Shop", "Shop", FormMethod.Get))
