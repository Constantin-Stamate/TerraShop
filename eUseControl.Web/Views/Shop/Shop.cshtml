                                            @if (product.ProductQuantity > 0)
                                            {
                                                using (Html.BeginForm("AddProductToCart", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("productId", product.Id)
                                                    <button type="submit" class="btn border border-primary rounded-pill px-3 text-secondary pulse-js" style="transition: background-color 0.3s ease, color 0.3s ease;" onmouseover="this.style.backgroundColor='#81C408'; this.style.setProperty('color', 'white', 'important');" onmouseout="this.style.backgroundColor=''; this.style.removeProperty('color');">
                                                        <i class="fa fa-shopping-bag me-2 text-secondary"></i> Add to Cart
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <a href="#" class="btn border border-primary rounded-pill px-3 pulse-js" style="background-color: #fff; color: #ccc; cursor: not-allowed; pointer-events: none;">
                                                    <i class="fa fa-shopping-bag me-2" style="color: #ccc;"></i> Add to Cart
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="info-message text-center mt-5">
                                <p>Currently, there are no recommendations for you. Come back soon for fresh picks!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
