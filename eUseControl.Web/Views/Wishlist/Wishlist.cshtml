@{
    Layout = "~/Views/Shared/_LayoutWishlist.cshtml";
    ViewBag.Title = "Wishlist";
}

@model IEnumerable<eUseControl.Web.Models.Product.ProductInfo>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="info-message text-center mt-5">
            <p style="font-size: 16px;">We’re out of products in your wishlist for now. Try adding some favorites or explore other categories!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Products</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Quality</th>
                        <th scope="col">Stock Status</th>
                        <th scope="col">Add to Cart</th>
                        <th scope="col">Handle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <th scope="row">
                                <a href="@Url.Action("ProductDetails", "Product", new { productId = product.Id })">
                                    <img src="@Url.Content(product.ProductImageUrl)" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" alt="">
                                </a>
                            </th>
                            <td>
                                <p class="mb-0 mt-4 truncate-text-user">@Html.DisplayFor(m => product.ProductName)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">$@Html.DisplayFor(m => product.ProductPrice)</p>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@Html.DisplayFor(m => product.ProductQuality)</p>
                            </td>
                            <td>
                                @if (product.ProductQuantity > 0)
                                {
                                    <div class="mt-4 px-2 py-1 text-success border border-success rounded" style="display: inline-block; background-color: #d4edda;">
                                        In Stock
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-4 px-2 py-1 text-danger border border-danger rounded" style="display: inline-block; background-color: #f8d7da;">
                                        Out of Stock
                                    </div>
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("AddProductToCart", "Cart", FormMethod.Post, new { style = "display: inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("productId", product.Id)
                                    <button type="submit" class="btn-recycle btn border border-secondary mt-4 px-4 py-2 pulse-js" style="background-color: @(product.ProductQuantity > 0 ? "white" : "#DCDCDC"); color: @(product.ProductQuantity > 0 ? "#81C408" : "#666"); cursor: @(product.ProductQuantity > 0 ? "pointer" : "not-allowed");" @(product.ProductQuantity == 0 ? "disabled" : "")>
                                        <i class="fa fa-shopping-bag me-2" style="margin-right:6px;"></i>Add to Cart
                                    </button>
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("RemoveProductFromWishlist", "Wishlist", FormMethod.Post, new { @class = "d-inline", id = "removeFromWishlistForm" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("productId", product.Id)
                                    <button type="submit" class="btn btn-md rounded-circle bg-light border mt-4 pulse-js" onclick="return confirm('Are you sure you want to remove this product from your wishlist?');">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>