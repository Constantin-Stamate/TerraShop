@{
    Layout = "~/Views/Shared/_LayoutChat.cshtml";
    ViewBag.Title = "Chat";
}

@model IEnumerable<eUseControl.Web.Models.Chat.ChatCompact>

@if (!Model.Any())
{
    <header class="header">
        <div class="header__title">
            <h1>Hello, There!</h1>
            <h2>How can I help you today?</h2>
        </div>
        <div class="suggests">
            <div class="suggests__item">
                <p class="suggests__item-text">What are the benefits of buying eco-friendly products ?</p>
                <div class="suggests__item-icon">
                    <i class='bx bx-leaf'></i>
                </div>
            </div>
            <div class="suggests__item">
                <p class="suggests__item-text">How can I start selling my handmade items online ?</p>
                <div class="suggests__item-icon">
                    <i class='bx bx-upload'></i>
                </div>
            </div>
            <div class="suggests__item">
                <p class="suggests__item-text">What is sustainable packaging and why does it matter ?</p>
                <div class="suggests__item-icon">
                    <i class='bx bx-box'></i>
                </div>
            </div>
            <div class="suggests__item">
                <p class="suggests__item-text">How do marketplaces support small eco businesses ?</p>
                <div class="suggests__item-icon">
                    <i class='bx bx-store-alt'></i>
                </div>
            </div>
        </div>
    </header>
}

<section class="chats">
    @foreach (var msg in Model)
    {
        <div class="message message--outgoing">
            <div class="message__content">
                <img class="message__avatar" src="@Url.Content("~/Assets/img/chat-icons/user.png")" alt="User avatar" />
                <p class="message__text">@Html.DisplayFor(m => msg.Prompt)</p>
            </div>
        </div>
        <div class="message message--incoming">
            <div class="message__content">
                <img class="message__avatar" src="@Url.Content("~/Assets/img/chat-icons/terra.svg")" alt="Terra avatar" />
                <p class="message__text">@Html.DisplayFor(m => msg.Message)</p>
                <div class="message__loading-indicator hide">
                    <div class="message__loading-bar"></div>
                    <div class="message__loading-bar"></div>
                    <div class="message__loading-bar"></div>
                </div>
            </div>
            <span onClick="copyMessageToClipboard(this)" class="message__icon">
                <i class='bx bx-copy-alt'></i>
            </span>
        </div>
    }
</section>

<section class="prompt">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "chatForm", @class = "prompt__form", novalidate = "novalidate" }))
    {
        <div class="prompt__input-wrapper">
            @Html.TextBox("message", null, new { placeholder = "Enter a prompt here", @class = "prompt__form-input", required = "required" })
            <button class="prompt__form-button" id="sendButton" type="submit">
                <i class='bx bx-send pulse-js'></i>
            </button>
        </div>
    }
    @using (Html.BeginForm("DeleteChatHistory", "Chat", FormMethod.Post, new { id = "deleteChatForm" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="prompt__form-button" id="deleteButton" style="margin-right: 390px; margin-top: -23px;">
            <i class='bx bx-trash pulse-js'></i>
        </button>
    }
    <p class="prompt__disclaim">TerraAI’s answers may not always be fully accurate or up to date — please double-check important info.</p>
</section>