﻿@{
    Layout = "~/Views/Shared/_LayoutOrderConfirmation.cshtml";
    ViewBag.Title = "OrderConfirmation";
}

@model eUseControl.Web.Models.Order.OrderMini

<div class="confirmation-content">
    <h1 style="margin-top: -25px; color: #82c408;">Order confirmed!</h1>
    <p class="thank-you-msg">
        <span class="icon">✔️</span>
        <span class="main-msg">Thank you for your purchase!</span>
    </p>
    <p class="sub-msg">A confirmation email has been sent with your order details.</p>
    <div class="order-details">
        <p><strong>Order number:</strong> #@Html.DisplayFor(model => Model.Id)</p>
        <p><strong>Date:</strong> @Html.Raw(Model.OrderDate.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture))</p>
        <p><strong>Total:</strong> $@Html.DisplayFor(model => Model.TotalPrice)</p>
    </div>
    <a href="@Url.Action("Index", "Main")" class="btn-recycle btn border border-secondary pulse-js" style="padding:10px 16px; width:auto; margin-top:20px; display:inline-flex; align-items:center; text-decoration:none;" onmouseover="this.querySelector('span').style.color='white'; this.querySelector('i').style.color='#81C408';" onmouseout="this.querySelector('span').style.color='#81C408'; this.querySelector('i').style.color='#81C408';">
        <i class="fas fa-home" style="margin-right:6px; font-size:16px; color:#81C408; position:relative; top:-1px;"></i>
        <span style="font-size:16px; color:#81C408;">Return home</span>
    </a>
</div>
