@{
    ViewBag.Title = "_Layout";
}

@using System.Web.Optimization

@model eUseControl.Web.Models.Main.MainViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>TerraShop</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon Image -->
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/Assets/img/favicon.ico")">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    @Styles.Render("~/bundles/lightbox/css")
    @Styles.Render("~/bundles/owl/carousel/min/css")

    <!-- Customized Bootstrap Stylesheet -->
    @Styles.Render("~/bundles/main/css")
    @Styles.Render("~/bundles/product-ui/css")
    @Styles.Render("~/bundles/layout/css")

    <!-- Template Stylesheet -->
    @Styles.Render("~/bundles/style/css")
</head>

<body>
    <!-- Spinner Start -->
    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50  d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    <!-- Spinner End -->

    <!-- Navbar Start -->
    <div class="container-fluid fixed-top">
        @Html.Action("Navbar", "Main")
    </div>
    <!-- Navbar End -->

    <!-- Modal Search Start -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        @Html.Partial("_ModalSearch")
    </div>
    <!-- Modal Search End -->

    <!-- Hero Start -->
    <div class="container-fluid py-5 mb-5 hero-header">
        <div class="container py-5">
            <div class="row g-5 align-items-center">
                <div class="col-md-12 col-lg-7">
                    <h4 class="mb-3 text-secondary">Sustainable Products for a Better Tomorrow</h4>
                    <h1 class="mb-5 display-3 text-primary" style="font-size: 52px;">Choose green, embrace change</h1>
                    @using (Html.BeginForm("Shop", "Shop", FormMethod.Get))
                    {
                        <div class="position-relative mx-auto">
                            @Html.TextBox("searchQuery", null, new { @class = "form-control border-2 border-secondary w-75 py-3 px-4 rounded-pill", type = "search", placeholder = "Search" })
                            <button type="submit" class="btn btn-primary border-2 border-secondary py-3 px-4 position-absolute rounded-pill text-white h-100" style="top: 0; right: 25%;">
                                Submit Now
                            </button>
                        </div>
                    }
                </div>
                <div class="col-md-12 col-lg-5">
                    <div id="carouselId" class="carousel slide position-relative" data-bs-ride="carousel">
                        <div class="carousel-inner" role="listbox">
                            <div class="carousel-item active rounded">
                                <img src="@Url.Content("~/Assets/img/volunteer-categories/volunteer-category-1.jpg")" class="img-fluid w-100 h-100 bg-secondary rounded" alt="First slide">
                                <a href="@Url.Action("Index", "Main")" class="btn px-4 py-2 text-white rounded">Wellness</a>
                            </div>
                            <div class="carousel-item rounded">
                                <img src="@Url.Content("~/Assets/img/volunteer-categories/volunteer-category-2.jpg")" class="img-fluid w-100 h-100 rounded" alt="Second slide">
                                <a href="@Url.Action("Index", "Main")" class="btn px-4 py-2 text-white rounded">Handmade</a>
                            </div>
                            <div class="carousel-item rounded">
                                <img src="@Url.Content("~/Assets/img/volunteer-categories/volunteer-category-3.jpg")" class="img-fluid w-100 h-100 rounded" alt="Third slide">
                                <a href="@Url.Action("Index", "Main")" class="btn px-4 py-2 text-white rounded">Toys</a>
                            </div>
                            <div class="carousel-item rounded">
                                <img src="@Url.Content("~/Assets/img/volunteer-categories/volunteer-category-4.jpg")" class="img-fluid w-100 h-100 rounded" alt="Fourth slide">
                                <a href="@Url.Action("Index", "Main")" class="btn px-4 py-2 text-white rounded">Recycled</a>
                            </div>
                            <div class="carousel-item rounded">
                                <img src="@Url.Content("~/Assets/img/volunteer-categories/volunteer-category-5.jpg")" class="img-fluid w-100 h-100 rounded" alt="Fifth slide">
                                <a href="@Url.Action("Index", "Main")" class="btn px-4 py-2 text-white rounded">Crafts</a>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Hero End -->

    @RenderBody()

    <!-- Features Section Start -->
    <div class="container-fluid featurs py-5" style="margin-top: -20px;">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="featurs-item text-center rounded bg-light p-4">
                        <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                            <i class="fas fa-leaf fa-3x text-white"></i>
                        </div>
                        <div class="featurs-content text-center">
                            <h5>Sustainable Products</h5>
                            <p class="mb-0">Eco-friendly and reusable</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="featurs-item text-center rounded bg-light p-4">
                        <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                            <i class="fas fa-recycle fa-3x text-white"></i>
                        </div>
                        <div class="featurs-content text-center">
                            <h5>Zero Waste Goals</h5>
                            <p class="mb-0">Less waste, more impact</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="featurs-item text-center rounded bg-light p-4">
                        <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                            <i class="fas fa-hand-holding-heart fa-3x text-white"></i>
                        </div>
                        <div class="featurs-content text-center">
                            <h5>Charity Support</h5>
                            <p class="mb-0">Funds donated to children</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="featurs-item text-center rounded bg-light p-4">
                        <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                            <i class="fas fa-users fa-3x text-white"></i>
                        </div>
                        <div class="featurs-content text-center">
                            <h5>Community Driven</h5>
                            <p class="mb-0">Supporting green initiatives</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Features Section End -->

    <!-- TerraShop Charity Banner Section Start -->
    <div class="container-fluid banner bg-secondary my-5" style="background: linear-gradient(to right, #84c30c, #a6d75b);">
        <div class="container py-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6">
                    <div class="py-4">
                        <h1 class="display-3 text-white">Shop with Purpose</h1>
                        <p class="fw-normal display-3 text-dark mb-4">NGO & Eco Support</p>
                        <p class="mb-4 text-dark">Every purchase you make at TerraShop helps NGOs and artisans create a better future. Discover handcrafted, recycled, and eco-friendly products that give back to the community while protecting the planet.</p>
                        <a href="@Url.Action("Index", "Main")" class="banner-btn btn border-2 border-white rounded-pill text-dark py-3 px-5" style="transition: background-color 0.3s ease, color 0.3s ease;" onmouseover="this.style.backgroundColor='#FFB524'; this.style.borderColor='#FFB524'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.borderColor='white'; this.style.color='black';">
                            DISCOVER MORE
                        </a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="@Url.Content("~/Assets/img/promotion/banner-sale-1.png")" class="img-fluid w-100 rounded" alt="">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- TerraShop Charity Banner Section End -->

    <!-- Products Shop Start -->
    <div class="container-fluid fruite py-5">
        <div class="container py-5">
            <div class="tab-class text-center">
                <div class="row g-4">
                    <div class="col-lg-4 text-start">
                        <h1>Featured Categories</h1>
                    </div>
                    <div class="col-lg-8 text-end">
                        <ul class="nav nav-pills d-inline-flex text-center mb-5" role="tablist">
                            @{
                                int tabIndex = 1;
                                foreach (var category in Model.Products.Keys)
                                {
                                    var activeClass = tabIndex == 1 ? "active" : "";
                                    <li class="nav-item">
                                        <a class="d-flex m-2 py-2 bg-light rounded-pill @activeClass" data-bs-toggle="pill" href="#tab-@tabIndex" role="tab">
                                            <span class="text-dark" style="width: 155px; white-space: nowrap;">@category</span>
                                        </a>
                                    </li>
                                    tabIndex++;
                                }
                            }
                        </ul>
                    </div>
                </div>
                <div class="tab-content">
                    @{
                        int tab = 1;
                        foreach (var kvp in Model.Products)
                        {
                            var activeClass = tab == 1 ? "active show" : "";
                            <div id="tab-@tab" class="tab-pane fade @activeClass p-0" role="tabpanel">
                                <div class="row g-4">
                                    @foreach (var product in kvp.Value)
                                    {
                                        <div class="col-md-6 col-lg-4 col-xl-3">
                                            <div class="rounded position-relative fruite-item">
                                                <div class="fruite-img">
                                                    <a href="@Url.Action("ProductDetails", "Product", new { productId = product.Id })">
                                                        <img src="@Url.Content(product.ProductImageUrl)" class="img-fluid w-100 rounded-top custom-image" alt="Product Image">
                                                    </a>
                                                </div>
                                                @using (Html.BeginForm(Model.WishlistProductIds.Contains(product.Id) ? "RemoveProductFromWishlist" : "AddProductToWishlist", "Wishlist", FormMethod.Post, new { @style = "position: absolute; top: 16px; right: 10px; z-index: 10;" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("productId", product.Id)
                                                    <button type="submit" style="background: none; border: none; cursor: pointer;">
                                                        <i class="@(Model.WishlistProductIds.Contains(product.Id) ? "fas fa-heart" : "far fa-heart") fa-lg pulsing-heart" style="color: #FFB524; transition: transform 0.3s ease;"></i>
                                                    </button>
                                                }
                                                <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">
                                                    @kvp.Key
                                                </div>
                                                <div class="p-4 border border-secondary border-top-0 rounded-bottom">
                                                    <h4 class="text-center product-name">@Html.DisplayFor(m => product.ProductName)</h4>
                                                    <p class="product-description">@Html.DisplayFor(m => product.ProductDescription)</p>
                                                    <div class="d-flex justify-content-between flex-lg-wrap">
                                                        <p class="text-dark fs-5 fw-bold mb-0">$@Html.DisplayFor(m => product.ProductPrice)</p>
                                                        @if (product.ProductQuantity > 0)
                                                        {
                                                            using (Html.BeginForm("AddProductToCart", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                @Html.Hidden("productId", product.Id)
                                                                <button type="submit" class="btn border border-secondary rounded-pill px-3 text-primary pulse-js">
                                                                    <i class="fa fa-shopping-bag me-2 text-primary"></i> Add to Cart
                                                                </button>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <a href="#" class="btn border border-secondary rounded-pill px-3 pulse-js" style="background-color: #fff; color: #ccc; cursor: not-allowed; pointer-events: none;">
                                                                <i class="fa fa-shopping-bag me-2" style="color: #ccc;"></i> Add to Cart
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            tab++;
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- Products Shop End -->

    <!-- Banner Section Start -->
    <div class="container-fluid banner bg-secondary my-5">
        <div class="container py-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6">
                    <div class="py-4">
                        <h1 class="display-3 text-white">Sustainable Picks</h1>
                        <p class="fw-normal display-3 text-dark mb-4">Shop at TerraShop</p>
                        <p class="mb-4 text-dark">Explore a diverse range of eco-friendly products, crafted with sustainability in mind, to support a greener and healthier future. Our products are designed to reduce environmental impact while offering you high-quality, sustainable alternatives for everyday use.</p>
                        <a href="@Url.Action("Shop", "Shop")" class="banner-btn btn border-2 border-white rounded-pill text-dark py-3 px-5">
                            BUY NOW
                        </a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="@Url.Content("~/Assets/img/promotion/banner-sale-2.png")" class="img-fluid rounded" style="margin-left: 20px;" alt="">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Banner Section End -->

    <!-- Fact Start -->
    <div class="container-fluid py-5">
        <div class="container">
            <div class="bg-light p-5 rounded">
                <div class="row g-4 justify-content-center">
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="counter bg-white rounded p-5">
                            <i class="fa fa-smile-beam text-secondary"></i>
                            <h4>Satisfied Customers</h4>
                            <h1>1963</h1>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="counter bg-white rounded p-5">
                            <i class="fa fa-thumbs-up text-secondary"></i>
                            <h4>Quality of Service</h4>
                            <h1>99%</h1>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="counter bg-white rounded p-5">
                            <i class="fa fa-certificate text-secondary"></i>
                            <h4>Quality Certificates</h4>
                            <h1>33</h1>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="counter bg-white rounded p-5">
                            <i class="fa fa-box text-secondary"></i>
                            <h4>Available Products</h4>
                            <h1>789</h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Fact End -->

    <!-- Testimonial Start -->
    <div class="container-fluid testimonial py-5">
        <div class="container py-5">
            <div class="testimonial-header text-center">
                <h4 class="text-primary">Our Testimonial</h4>
                <h1 class="display-5 mb-5 text-dark">Our Clients Saying!</h1>
            </div>
            <div class="owl-carousel testimonial-carousel">
                @foreach (var item in Model.ReviewsWithProfiles)
                {
                    <div class="testimonial-item img-border-radius bg-light rounded p-4">
                        <div class="position-relative">
                            <i class="fa fa-quote-right fa-2x text-secondary position-absolute" style="bottom: 30px; right: 0;"></i>
                            <div class="mb-4 pb-4 border-bottom border-secondary">
                                <p class="mb-0 truncate-text-large">@Html.DisplayFor(m => item.Review.Review)</p>
                            </div>
                            <div class="d-flex align-items-center flex-nowrap">
                                <div class="rounded overflow-hidden" style="width: 100px; height: 100px;">
                                    <img src="@Url.Content(item.Profile.ProfileImageUrl)" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Client Image">
                                </div>
                                <div class="ms-4 d-block">
                                    <h4 class="text-dark truncate-text-user">@Html.DisplayFor(m => item.Profile.FirstName) @Html.DisplayFor(m => item.Profile.LastName)</h4>
                                    <p class="m-0 pb-3">@Html.Raw(item.Review.ReviewPostDate.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture))</p>
                                    <div class="d-flex pe-5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.Review.Rating)
                                            {
                                                <i class="fa fa-star text-secondary"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-star"></i>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- Testimonial End -->

    <!-- Footer Start -->
    <div class="container-fluid bg-dark text-white-50 footer pt-5 mt-5">
        @Html.Partial("_Footer")
    </div>
    <!-- Footer End -->

    <!-- Copyright Start -->
    <div class="container-fluid copyright bg-dark py-4">
        @Html.Partial("_Copyright")
    </div>
    <!-- Copyright End -->

    <!-- Back to Top -->
    <a href="@Url.Action("Index", "Main")" class="btn btn-primary border-3 border-primary rounded-circle back-to-top">
        <i class="fa fa-arrow-up"></i>
    </a>

    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    @Scripts.Render("~/bundles/easing/min/js")
    @Scripts.Render("~/bundles/waypoints/js")
    @Scripts.Render("~/bundles/lightbox/js")
    @Scripts.Render("~/bundles/owl/carousel/min/js")
    @Scripts.Render("~/bundles/animations/js")

    <!-- Template Javascript -->
    @Scripts.Render("~/bundles/main/js")
</body>

</html>